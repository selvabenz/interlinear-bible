{
  "name": "interlinear-bible",
  "private": true,
  "version": "0.1.0",
  "description": "Interlinear and reverse-interlinear Bible study PWA (IRV Tamil · Greek/Hebrew), data-driven from aligned USFM.",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/build-content.ts --check",
    "content:strict": "tsx scripts/build-content.ts --check --strict",
    "sources": "tsx scripts/sources/generate.ts",
    "maps": "tsx scripts/build-maps.ts",
    "sources:survey": "tsx scripts/sources/survey.ts",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "tsx scripts/make-icons.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/gentium-book-plus": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
