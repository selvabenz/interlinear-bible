ng="G5613,G1401" x-morph="PRT,N-ASM"\w*\zsem-e\* \w இல்லை|strong="G3756" x-morph="PRT-N + G2089:ADV"\w*\zsem-e\*, \zsem-s |x-unit="U16.4" x-type="RELATION" x-src="PHM 1:16#05-06" x-content="ὑπὲρ δοῦλον," x-strong="G5228,G1401" x-real="LEXICALLY_REALIZED" x-props="CROSS_VERSE" x-scope="APPEAL" x-s7="PRESERVED" x-dim="" x-cov="COVERED_BY_RESTRUCTURING" x-review="AI_PROPOSED"\*\w அடிமையானவனுக்கு|strong="G1401" x-morph="N-ASM"\w* \w மேலானவனாகவும்|strong="G0235,G5228" x-morph="CONJ,PREP"\w*\zsem-e\* \zsem-s |x-unit="U16.5" x-type="RELATION" x-src="PHM 1:16#07-08" x-content="ἀδελφὸν ἀγαπητόν," x-strong="G0080,G0027" x-real="LEXICALLY_REALIZED" x-props="CROSS_VERSE SPLIT" x-scope="APPEAL" x-s7="PRESERVED_WITH_RESTRUCTURING" x-dim="" x-cov="COVERED_BY_RESTRUCTURING" x-review="AI_PROPOSED" x-note="'beloved brother' realized twice: as purpose in v15 and as the protasis 'if he is a beloved brother to me' in v16" x-span="1/2"\*\w பிரியமுள்ள|strong="G0027" x-morph="A-ASM"\w* \w சகோதரனாகவும்|strong="G0080" x-morph="N-ASM"\w*\zsem-e\* \w இருப்பதற்காகவும்\w*\zsem-e\* \zsem-s |x-unit="U15.5" x-type="TEMPORAL" x-src="PHM 1:15#06-07" x-content="πρὸς ὥραν," x-strong="G4314,G5610" x-real="LEXICALLY_REALIZED" x-props="" x-scope="APPEAL" x-s7="PRESERVED" x-dim="" x-cov="COVERED" x-review="AI_PROPOSED"\*\w கொஞ்ச|strong="G4314,G5610" x-morph="PREP,N-ASF"\w* \w காலம்|strong="G4314,G5610" x-morph="PREP,N-ASF"\w*\zsem-e\* \zsem-s |x-unit="U15.4" x-type="EVENT" x-src="PHM 1:15#05" x-content="ἐχωρίσθη" x-strong="G5563" x-real="LEXICALLY_REALIZED" x-props="" x-scope="APPEAL" x-s7="PRESERVED_WITH_RESTRUCTURING" x-dim="PARTICIPANT" x-cov="COVERED" x-review="AI_PROPOSED" x-note="passive ἐχωρίσθη 'he was separated' (possibly divine passive) → active 'he left you and went away'; agency nuance lost but event preserved"\*\w உம்மை|strong="G5563" x-morph="V-API-3S"\w* \w விட்டுப்|strong="G5563" x-morph="V-API-3S"\w* \w பிரிந்து|strong="G5563" x-morph="V-API-3S"\w* \w போனான்|strong="G5563" x-morph="V-API-3S"\w*\zsem-e\*.\zsem-nl |x-unit="U15.1" x-type="MODALITY" x-src="PHM 1:15#01" x-content="τάχα" x-strong="G5029" x-cov="POSSIBLY_MISSING" x-scope="APPEAL" x-review="AI_PROPOSED" x-reason="τάχα 'perhaps' — searched 1:15–1:16; no hedge anywhere in the Tamil sentence. MODALITY: Paul's tentativeness about providence is lost."\*\zsem-i |x-unit="U15.2" x-type="DISCOURSE" x-src="PHM 1:15#02" x-content="γὰρ" x-strong="G1063" x-real="IMPLICIT" x-props="" x-scope="APPEAL" x-s7="PRESERVED" x-dim="" x-cov="COVERED" x-review="AI_PROPOSED"\*\zsem-nl |x-unit="U15.3" x-type="RELATION" x-src="PHM 1:15#03-04" x-content="διὰ τοῦτο" x-strong="G1223,G3778" x-cov="POSSIBLY_MISSING" x-scope="APPEAL" x-review="AI_PROPOSED" x-reason="διὰ τοῦτο 'for this reason' — the anaphoric causal link (separation happened for the purpose that follows) is not realized; the ἵνα purpose itself is (U15.6). RELATION."\*
\v 16 \w அவன்|x-support="GRAMMATICALLY_REQUIRED" x-reason="subject அவன்"\w* \zsem-s |x-unit="U16.6" x-type="RELATION" x-src="PHM 1:16#09-10" x-content="μάλιστα ἐμοί," x-strong="G3122,G1473" x-real="LEXICALLY_REALIZED" x-props="" x-scope="APPEAL" x-s7="UNDERTRANSLATED" x-dim="SPECIFICITY" x-cov="COVERED" x-review="AI_PROPOSED" x-note="ἐμοί 'to me' located (எனக்குப்); μάλιστα 'especially' has no realization. LOCATED but not fully PRESERVED."\*\w எனக்குப்|strong="G1473" x-morph="P-1DS"\w*\zsem-e\* \zsem-s |x-unit="U16.5" x-type="RELATION" x-src="PHM 1:16#07-08" x-content="ἀδελφὸν ἀγαπητόν," x-strong="G0080,G0027" x-real="LEXICALLY_REALIZED" x-props="CROSS_VERSE SPLIT" x-scope="APPEAL" x-s7="PRESERVED_WITH_RESTRUCTURING" x-dim="" x-cov="COVERED_BY_RESTRUCTURING" x-review="AI_PROPOSED" x-note="'beloved brother' realized twice: as purpose in v15 and as the protasis 'if he is a beloved brother to me' in v16" x-span="2/2"\*\w பிரியமான\w* \w சகோதரனென்றால்\w*\zsem-e\*, \zsem-s |x-unit="U16.7" x-type="RELATION" x-src="PHM 1:16#11-12-13-14" x-content="πόσῳ δὲ μᾶλλον σοὶ" x-strong="G4214,G1161,G3123,G4771" x-real="LEXICALLY_REALIZED" x-props="DISCONTIGUOUS" x-scope="APPEAL" x-s7="PRESERVED_WITH_RESTRUCTURING" x-dim="" x-cov="COVERED_BY_RESTRUCTURING" x-review="AI_PROPOSED" x-note="'how much more to you' → 'how much [more beloved] should he be to you'; recast as apodosis"\*\w உமக்கு|strong="G4771" x-morph="P-2DS"\w* \zsem-s |x-unit="U16.8" x-type="RELATION" x-src="PHM 1:16#15-16-17-18-19-20" x-content="καὶ ἐν σαρκὶ καὶ ἐν κυρίῳ;" x-strong="G2532,G1722,G4561,G2532,G1722,G2962" x-real="LEXICALLY_REALIZED" x-props="" x-scope="APPEAL" x-s7="PRESERVED" x-dim="" x-cov="COVERED" x-review="AI_PROPOSED"\*\w சரீரத்தின்படியும்|strong="G2532,G1722,G4561" x-morph="CONJ,PREP,N-DSF"\w* \w கர்த்தருக்குள்ளும்|strong="G2532,G1722,G2962" x-morph="CONJ,PREP,N-DSM-T"\w*\zsem-e\* \w எவ்வளவு|strong="G4214,G3123" x-morph="Q-DSN,ADV"\w*\zsem-e\* \w பிரியமுள்ளவனாக|x-support="CONTEXT_SUPPORTED" x-reason="பிரியமுள்ளவனாக 'beloved' as predicate of 'how much more' — supplied from ἀγαπητόν in the same verse"\w* \w இருக்க|x-support="GRAMMATICALLY_REQUIRED" x-reason="copula இருக்க"\w* \w வேண்டும்|x-support="GRAMMATICALLY_REQUIRED" x-reason="modal வேண்டும்"\w*!\zsem-i |x-unit="U16.3" x-type="DISCOURSE" x-src="PHM 1:16#04" x-content="ἀλλ᾽" x-strong="G0235" x-real="IMPLICIT" x-props="CROSS_VERSE" x-scope="APPEAL" x-s7="PRESERVED" x-dim="" x-cov="COVERED" x-review="AI_PROPOSED" x-note="ἀλλά — contrast carried by இல்லை … மேலானவனாகவும்"\*
